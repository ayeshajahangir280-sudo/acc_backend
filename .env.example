# Copy to .env (never commit .env). All values are placeholders.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_TIME_ZONE=UTC
DJANGO_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0

# Database (engine is chosen by the URL scheme: postgres://, mysql://, sqlite:///path)
# Leave unset ONLY for local development (falls back to a throwaway dev.sqlite3).
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Comma-separated, include scheme. Your deployed frontend origin(s).
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

API_THROTTLE_USER=2000/hour
